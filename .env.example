# Sandbox is the only default. "testnet" still uses the mock rail in v0.
# "mainnet" is rejected at startup for either name.
# ROSTER_MODE is the product name. ALBESA_MODE is the same switch.
# If both are set, they must match.
ROSTER_MODE=sandbox
# ALBESA_MODE=sandbox
PORT=8787

# JSON file for sandbox organizations, agents, balances, and the ledger.
# The API stores SHA-256 hashes of sandbox keys, not the secrets.
# ALBESA_DATA_FILE=data/sandbox.json

# Mock reputation ledger. Omit to use data/reputation.json under the API process.
# ROSTER_REPUTATION_FILE=data/reputation.json

# JSON file for capability listings. The API process defaults to data/registry.json.
# REGISTRY_INDEX_PATH=data/registry.json

# Supabase (Roster Network, project ref wbesppsdeyssfqynuezb, eu-west-1).
# Leave all three unset to keep the JSON sandbox files.
# Set all three on roster-api. Never commit the real keys.
# SUPABASE_URL=https://wbesppsdeyssfqynuezb.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
#
# The Next.js console needs the same URL and anon key under the public names
# at build time. Do not give the service role key to roster-web, and do not
# put it in a NEXT_PUBLIC_ variable.
# NEXT_PUBLIC_SUPABASE_URL=https://wbesppsdeyssfqynuezb.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# Dashboard only (not secrets, and not read by the process):
# Site URL: https://roster.network
# Redirect URLs: https://roster.network/** http://localhost:3000/**
#   http://127.0.0.1:3000/** http://localhost:7000/** http://127.0.0.1:7000/**
# Enable the GitHub and Google providers. Callback path: /auth/callback

# MCP server only. The API process does not read these.
# ROSTER_API_KEY is the sandbox key returned by POST /v1/accounts (or login).
# ROSTER_API_URL defaults to http://127.0.0.1:8787.
# ROSTER_API_KEY=sk_sandbox_...
# ROSTER_API_URL=http://127.0.0.1:8787

# Transport hardening (roster-api server).
# Rate limits are on by default in the server: sign-up/login 20/min and
# waitlist 10/min per client address, 30 failed auth attempts per 10 min,
# 1200 authenticated calls/min per organization. ROSTER_RATE_LIMIT=0 turns them off.
# ROSTER_RATE_LIMIT=1
# One JSON access-log line per request. ROSTER_ACCESS_LOG=0 silences it.
# ROSTER_ACCESS_LOG=1
# Background SLA sweep that refunds held jobs past their deadline. 0 turns it off.
# ROSTER_EXPIRE_INTERVAL_MS=15000
# Commit reported by /health. scripts/deploy-roster-api.sh sets it.
# ROSTER_GIT_SHA=

# Public site URL for canonical links and Open Graph images (roster-web build).
# NEXT_PUBLIC_SITE_URL=https://roster.network
