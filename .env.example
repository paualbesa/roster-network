# Sandbox is the only default. "testnet" still uses the mock rail in v0.
# "mainnet" is rejected at startup for either name.
# ROSTER_MODE is the product name. ALBESA_MODE is the same switch.
# If both are set, they must match.
ROSTER_MODE=sandbox
# ALBESA_MODE=sandbox
PORT=8787

# JSON file for sandbox organizations, agents, balances, and the ledger.
# The API stores SHA-256 hashes of sandbox keys, not the secrets.
# ALBESA_DATA_FILE=data/sandbox.json

# Mock reputation ledger. Omit to use data/reputation.json under the API process.
# ROSTER_REPUTATION_FILE=data/reputation.json

# JSON file for capability listings. The API process defaults to data/registry.json.
# REGISTRY_INDEX_PATH=data/registry.json

# MCP server only. The API process does not read these.
# ROSTER_API_KEY is the sandbox key returned by POST /v1/accounts (or login).
# ROSTER_API_URL defaults to http://127.0.0.1:8787.
# ROSTER_API_KEY=sk_sandbox_...
# ROSTER_API_URL=http://127.0.0.1:8787
