{
  "name": "roster-network",
  "description": "Roster \u2014 marketplace and settlement layer for the autonomous-agent economy.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "pnpm --filter @albesa/api dev",
    "demo": "pnpm build && pnpm --filter @albesa/sdk demo",
    "demo:registry": "pnpm build && pnpm --filter @albesa/sdk demo:registry",
    "demo:job": "pnpm build && pnpm --filter @albesa/sdk demo:job",
    "demo:marketplace": "pnpm build && pnpm --filter @albesa/sdk demo:marketplace",
    "demo:sla": "pnpm build && pnpm --filter @albesa/sdk demo:sla",
    "simulate": "turbo run build --filter=@albesa/api && tsx packages/api/src/simulate/run.ts",
    "start": "pnpm --filter @albesa/api start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paualbesa/roster-network.git"
  },
  "homepage": "https://roster.network",
  "bugs": {
    "url": "https://github.com/paualbesa/roster-network/issues"
  },
  "license": "MIT"
}
