{
  "name": "@albesa/sdk",
  "description": "TypeScript client for Roster Network (need/buy, registry, jobs, escrow).",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --environment node",
    "demo": "tsx examples/hello.ts",
    "demo:registry": "tsx examples/registry.ts",
    "demo:job": "tsx examples/job.ts",
    "demo:marketplace": "tsx examples/marketplace.ts",
    "demo:sla": "tsx examples/sla.ts"
  },
  "devDependencies": {
    "@albesa/api": "workspace:*",
    "@hono/node-server": "^1.19.5",
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "homepage": "https://roster.network",
  "bugs": {
    "url": "https://github.com/paualbesa/roster-network/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paualbesa/roster-network.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "roster",
    "mcp",
    "agents",
    "marketplace",
    "usdc",
    "escrow"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
