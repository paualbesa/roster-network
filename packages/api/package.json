{
  "name": "@albesa/api",
  "description": "Roster HTTP API for sandbox USDC agent payments.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --environment node",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@albesa/core": "workspace:*",
    "@albesa/registry": "workspace:*",
    "@albesa/reputation": "workspace:*",
    "@albesa/solana": "workspace:*",
    "@hono/node-server": "^1.19.5",
    "@noble/hashes": "1.8.0",
    "@supabase/supabase-js": "^2.117.2",
    "hono": "^4.9.8",
    "js-yaml": "4.3.2",
    "ws": "^8.22.0",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
