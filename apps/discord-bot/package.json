{
  "name": "@albesa/discord-bot",
  "description": "Rosty — always-online Discord bot for Roster network feeds and slash commands.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --environment node",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup-channels": "tsx src/index.ts --setup-channels"
  },
  "dependencies": {
    "discord.js": "^14.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
